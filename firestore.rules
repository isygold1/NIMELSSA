rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──
    // Each user can only read/write their own profile document.
    // The app uses this for display name, email, role, level.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── SHARED COLLECTIONS ──
    // courses, resources, proposals, reports, level_textbooks,
    // course_aliases, course_resources:
    // Any authenticated user can read/write. Role-based enforcement is handled
    // at the app layer (UI visibility, navigation guards, API call restrictions).
    //
    // course_aliases: written by Link Code / Edit Course Code in the rep/admin
    // desk (old CCMAS code -> current code). course_resources: legacy store,
    // read at startup for migration into resources/.
    //
    // Rationale:
    //   - Firebase custom claims (request.auth.token.role) are NOT used — roles
    //     are stored in /users/{uid}, which would require a get() call in every
    //     rule, adding latency and cost.
    //   - The app already restricts admin/rep screens behind UserRole checks and
    //     never exposes write capabilities to students outside ProposeScreen.
    //   - This keeps rules simple, fast, and auditable.
    //
    // Future improvement: if tighter rules are needed, add Firestore get()
    // calls here to read /users/{request.auth.uid} and check the role field.
    match /courses/{document} {
      allow read, write: if request.auth != null;
    }
    match /resources/{document} {
      allow read, write: if request.auth != null;
    }
    match /proposals/{document} {
      allow read, write: if request.auth != null;
    }
    match /reports/{document} {
      allow read, write: if request.auth != null;
    }
    match /level_textbooks/{document} {
      allow read, write: if request.auth != null;
    }
    match /course_aliases/{variant} {
      allow read, write: if request.auth != null;
    }
    match /course_resources/{document} {
      allow read, write: if request.auth != null;
    }
  }
}